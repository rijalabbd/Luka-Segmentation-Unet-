# PostgreSQL Database (service: db)
POSTGRES_USER=woundai
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=woundai_db
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://woundai:changeme_local_only@localhost:5435/woundai_db
TEST_DATABASE_URL=postgresql+asyncpg://woundai:changeme_local_only@localhost:5435/woundai_test

# Backend FastAPI & Storage
BACKEND_PORT=8000
STORAGE_DIR=backend/storage
SEED_DEMO_ON_STARTUP=false
MODEL_CHECKPOINT_PATH=ml/checkpoints/unet_resnet34_best.pth

# Google Gemini API (Factual Grounding — kosongkan di repo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=800
GEMINI_TIMEOUT_SECONDS=10

# Frontend Vue 3 + Vite
VITE_API_BASE_URL=/api/v1
