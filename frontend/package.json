{
  "name": "woundai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test src/utils/calibrationCoords.test.ts src/utils/cameraCrop.test.ts src/utils/ghostTransform.test.ts src/utils/touchDevice.test.ts src/utils/trendChart.test.ts src/utils/visitWarnings.test.ts",
    "test:components": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^2.2.4"
  }
}
